# ssh.benjaminberger.at — SSH Console (web SSH gateway).
# Behind Cloudflare (proxied): edge TLS to the browser, wildcard LE cert to the origin.
# Only Cloudflare may talk to this vhost: the app trusts X-Country (from CF-IPCountry)
# to decide whether a 2FA code is required, so a direct hit on the origin must never
# be able to forge it.

geo $realip_remote_addr $console_from_cf {
    default 0;
    127.0.0.1 1;
    ::1 1;
    173.245.48.0/20 1;
    103.21.244.0/22 1;
    103.22.200.0/22 1;
    103.31.4.0/22 1;
    141.101.64.0/18 1;
    108.162.192.0/18 1;
    190.93.240.0/20 1;
    188.114.96.0/20 1;
    197.234.240.0/22 1;
    198.41.128.0/17 1;
    162.158.0.0/15 1;
    104.16.0.0/13 1;
    104.24.0.0/14 1;
    172.64.0.0/13 1;
    131.0.72.0/22 1;
    2400:cb00::/32 1;
    2606:4700::/32 1;
    2803:f800::/32 1;
    2405:b500::/32 1;
    2405:8100::/32 1;
    2a06:98c0::/29 1;
    2c0f:f248::/32 1;
}

map $http_upgrade $console_conn_upgrade { default upgrade; '' close; }
limit_req_zone $binary_remote_addr zone=console_api:10m rate=30r/s;

upstream webconsole { server 127.0.0.1:3099; keepalive 16; }

server {
    listen 80;
    listen [::]:80;
    server_name ssh.benjaminberger.at;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ssh.benjaminberger.at;

    ssl_certificate     /etc/letsencrypt/live/benjaminberger-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/benjaminberger-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    include snippets/cloudflare-real-ip.conf;
    if ($console_from_cf = 0) { return 444; }

    access_log /var/log/nginx/ssh.benjaminberger.at.access.log;
    error_log  /var/log/nginx/ssh.benjaminberger.at.error.log;

    server_tokens off;
    client_max_body_size 10m;      # SFTP uploads arrive in <= 9 MB chunks

    proxy_http_version 1.1;

    # NB: nginx does not inherit proxy_set_header into a location that sets its own,
    # so every location includes the shared headers explicitly.
    # Terminal traffic: no buffering, no delay, long-lived.
    location = /ws {
        proxy_pass http://webconsole;
        include snippets/console-proxy-headers.conf;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $console_conn_upgrade;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        tcp_nodelay on;
    }

    location /api/ {
        limit_req zone=console_api burst=60 nodelay;
        proxy_pass http://webconsole;
        include snippets/console-proxy-headers.conf;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        proxy_pass http://webconsole;
        include snippets/console-proxy-headers.conf;
        proxy_set_header Connection "";
    }
}
